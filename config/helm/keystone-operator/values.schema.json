{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dogukanturhal/platform/-/raw/master/services/keystone/config/helm/keystone-operator/values.schema.json",
  "title": "keystone-operator values",
  "description": "JSON Schema for the keystone-operator Helm chart values. Type-checks the load-bearing fields so `helm lint` catches common misconfiguration before install.",
  "type": "object",
  "additionalProperties": true,
  "required": ["replicaCount", "image", "systemNamespace"],
  "properties": {
    "systemNamespace": {
      "type": "string",
      "minLength": 1,
      "description": "Namespace Keystone reads Secrets from. Must match the release namespace in single-installation setups."
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] },
        "pullSecrets": {
          "type": "array",
          "items": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string" } } }
        }
      }
    },
    "fullnameOverride": { "type": "string" },
    "nameOverride": { "type": "string" },
    "commonLabels": { "type": "object" },
    "commonAnnotations": { "type": "object" },
    "controller": {
      "type": "object",
      "properties": {
        "leaderElect": { "type": "boolean" },
        "leaderElectionID": { "type": "string" },
        "role": { "type": "string", "enum": ["hub", "spoke"] },
        "watchNamespaces": { "type": "string" },
        "driftCheckInterval": { "type": "string" },
        "enableWebhooks": { "type": "boolean" },
        "enableHTTP2": { "type": "boolean" },
        "extraArgs": { "type": "array", "items": { "type": "string" } },
        "extraEnv": { "type": "array" },
        "extraVolumes": { "type": "array" },
        "extraVolumeMounts": { "type": "array" },
        "crTTL": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "checkInterval": { "type": "string" },
            "retainSuccess": { "type": "string" },
            "retainFailure": { "type": "string" }
          }
        }
      }
    },
    "resources": {
      "type": "object",
      "properties": {
        "requests": { "type": "object" },
        "limits": { "type": "object" }
      }
    },
    "podSecurityContext": { "type": "object" },
    "containerSecurityContext": { "type": "object" },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" },
    "topologySpreadConstraints": { "type": "array" },
    "priorityClassName": { "type": "string" },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
    "livenessProbe": { "type": "object" },
    "readinessProbe": { "type": "object" },
    "metrics": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "secure": { "type": "boolean" },
        "port": { "type": "integer" },
        "service": { "type": "object" },
        "serviceMonitor": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "namespace": { "type": "string" },
            "interval": { "type": "string" },
            "scrapeTimeout": { "type": "string" },
            "labels": { "type": "object" },
            "tlsCaSecretName": { "type": "string" },
            "relabelings": { "type": "array" },
            "metricRelabelings": { "type": "array" }
          }
        },
        "prometheusRule": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "namespace": { "type": "string" },
            "labels": { "type": "object" },
            "reconcileSuccessObjective": { "type": "number", "minimum": 0, "maximum": 1 },
            "migrationApplyP99Seconds": { "type": "number", "minimum": 0 }
          }
        },
        "pprof": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "renderReaderClusterRole": { "type": "boolean" }
          }
        }
      }
    },
    "webhook": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "port": { "type": "integer" },
        "service": { "type": "object" },
        "failurePolicy": { "type": "string", "enum": ["Fail", "Ignore"] },
        "certManager": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "issuerRef": {
              "type": "object",
              "properties": {
                "kind": { "type": "string", "enum": ["Issuer", "ClusterIssuer"] },
                "name": { "type": "string" },
                "group": { "type": "string" }
              }
            },
            "duration": { "type": "string" },
            "renewBefore": { "type": "string" },
            "privateKey": { "type": "object" }
          }
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "annotations": { "type": "object" },
        "name": { "type": "string" }
      }
    },
    "rbac": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "extraEgressCIDRs": { "type": "array" },
        "extraEgressNamespaceSelectors": { "type": "array" },
        "allowDNS": { "type": "boolean" },
        "otlpNamespaceSelector": { "type": "object" }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": { "type": ["integer", "string"] },
        "maxUnavailable": { "type": ["integer", "string"] }
      }
    },
    "otel": {
      "type": "object",
      "properties": {
        "endpoint": { "type": "string" },
        "insecure": { "type": "boolean" }
      }
    },
    "podAnnotations": { "type": "object" },
    "podLabels": { "type": "object" }
  }
}
